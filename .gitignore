venv/
env/

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Build and generated outputs
backend/outputs/
backend/app/outputs/
frontend/dist/

# Local project data (keep structure, ignore contents)
backend/data/documents/*
backend/data/images/*
data/documents/*
data/images/*
data/samples/*

# Keep placeholder files if present
!backend/data/documents/.gitkeep
!backend/data/images/.gitkeep
!data/documents/.gitkeep
!data/images/.gitkeep
!data/samples/.gitkeep
